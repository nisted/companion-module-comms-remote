{
	"name": "comms-remote",
	"version": "0.5.0",
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.build.json",
		"package": "run build && companion-module-build",
		"dev": "tsc -p tsconfig.build.json --watch",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"test": "node --test \"test/*.test.mjs\""
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nisted/companion-module-comms-remote.git"
	},
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.2.2"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.2.0",
		"@types/node": "^22.15.18",
		"rimraf": "^6.0.1",
		"typescript": "~5.9.3"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.13.0"
}
